// ─── REMEDIATION CORRELATION (V2 — additive, feature-flagged) ─────────────────
// A RemediationCase is an AGGREGATION layer over multiple CryptoObservation
// findings that share a common root cause. It NEVER replaces or deletes the
// underlying observations — the scanner evidence remains the source of truth.
// This model is only populated when REMEDIATION_ENGINE=v2. Under the default
// (v1) the existing per-observation RemediationJob flow is entirely unaffected.
model RemediationCase {
  id             String   @id @default(cuid())
  ref            String   @unique
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  title          String
  repoUrl        String?
  algorithm      String?
  purpose        String?
  vulnerabilityType String?
  rootCause      String?
  securityImpact String?
  // Selected remediation strategy — populated in a later phase; nullable now.
  strategy       String?
  // Deterministic key used to group findings (repo|file|algorithm|purpose).
  correlationKey String
  // Which scanners contributed evidence, e.g. ["CRYPTOSCAN","SEMGREP"].
  evidenceSources      String[]
  affectedFiles        String[]
  affectedDependencies String[]
  confidence     Int      @default(0)
  findingCount   Int      @default(0)
  status         String   @default("OPEN") // OPEN | PLANNED | IN_PROGRESS | VERIFIED | FAILED | DISMISSED
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  findings         RemediationCaseFinding[]
  verificationRuns VerificationRun[]

  @@index([tenantId])
  @@index([status])
  @@index([correlationKey])
}

// Join table linking a RemediationCase to the observations it aggregates.
// Cascade delete only removes the LINK when a case is deleted — the underlying
// CryptoObservation is never touched.
model RemediationCaseFinding {
  id            String   @id @default(cuid())
  caseId        String
  case          RemediationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  observationId String
  observation   CryptoObservation @relation(fields: [observationId], references: [id])
  sensorType    String
  addedAt       DateTime @default(now())

  @@unique([caseId, observationId])
  @@index([observationId])
}

// ─── REMEDIATION VERIFICATION (V2 — additive, feature-flagged) ─────────────────
// A VerificationRun records ONE attempt to prove a RemediationCase was resolved.
// It captures an immutable BEFORE baseline, re-runs the relevant scanners
// (through the existing public engine interfaces — read-only, never writing to
// the live observation store), optionally builds/tests, and compares. The
// scanner/build/test EVIDENCE determines the verdict — never the AI's opinion.
// Only populated when REMEDIATION_ENGINE=v2; entirely dormant under the default.
model VerificationRun {
  id        String   @id @default(cuid())
  ref       String   @unique
  caseId    String
  case      RemediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  // Lifecycle + terminal verdict, e.g. PENDING | RUNNING | BASELINING | BUILDING
  // | TESTING | RESCANNING | COMPARING | VERIFIED | VERIFIED_WITH_WARNINGS |
  // FAILED | REGRESSED | BUILD_FAILED | TEST_FAILED | SCAN_FAILED | TIMEOUT |
  // VERIFICATION_ERROR | CANCELLED | NO_BASELINE
  status        String @default("PENDING")
  verdictReason String?

  repoUrl   String?
  baseRef   String?   // repo revision the baseline reflects, if known
  patchRef  String?   // repo revision after the change, if known

  timeoutMs  Int      @default(600000)
  deadlineAt DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  // Build / test outcomes: NOT_RUN | SKIPPED | PASS | FAIL
  buildStatus String?
  buildResult Json?
  testStatus  String?
  testResult  Json?

  // Comparison rollup, e.g. { resolved, residual, moved, newHigh, newLow }
  summary Json?
  error   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings       VerificationFinding[]
  scannerResults VerificationScannerResult[]

  @@index([caseId])
  @@index([tenantId])
  @@index([status])
}

// Immutable BEFORE/AFTER finding snapshots — the evidence behind a verdict.
model VerificationFinding {
  id                String   @id @default(cuid())
  verificationRunId String
  run               VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  phase             String   // BEFORE | AFTER
  scanner           String
  fingerprint       String   // stable identity: scanner|rule/algo|normalizedLocation|dependency
  algorithm         String?
  ruleId            String?
  normalizedLocation String?
  dependency        String?
  severity          String?
  // Links a BEFORE snapshot back to its source observation (nullable).
  observationId     String?
  rawJson           Json?
  createdAt         DateTime @default(now())

  @@index([verificationRunId])
  @@index([fingerprint])
}

// Per-scanner run metadata for a verification phase (health/coverage/failure).
model VerificationScannerResult {
  id                String   @id @default(cuid())
  verificationRunId String
  run               VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  phase        String   // BEFORE | AFTER
  scanner      String
  status       String   // OK | UNAVAILABLE | ERROR | TIMEOUT | SKIPPED
  findingCount Int      @default(0)
  durationMs   Int?
  error        String?
  createdAt    DateTime @default(now())

  @@index([verificationRunId])
}

model Notification {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  userId     String
  title      String
  body       String?
  entityType String?
  entityId   String?
  entityRef  String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, userId])
}

